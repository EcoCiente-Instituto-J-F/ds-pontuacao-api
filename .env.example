# Porta publicada pelo docker-compose
APP_PORT=8080

# Porta HTTP da aplicacao (padrao: 9786)
SERVER_PORT=9786

# Segredo HMAC dos tokens JWT (minimo 32 bytes; recomendado 64+)
JWT_SECRET=CHANGEME

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ecociente
DB_USER=CHANGEME
DB_PASSWORD=CHANGEME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=CHANGEME
REDIS_PASSWORD=CHANGEME

# Inicio do primeiro ciclo do ranking (formato yyyy-MM-dd)
RANKING_CYCLE_EPOCH=2020-01-01
